# Copy this file to .env and edit.
SECRET_KEY=change-this-to-a-long-random-string
# SQLite is the default (no setup). For PostgreSQL use e.g.:
# DATABASE_URL=postgresql://user:password@localhost:5432/lostfound
# Roll numbers that become admins when they register (comma separated)
ADMIN_ROLLS=
# WhatsApp via Twilio (leave empty to print messages in the terminal instead)
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
